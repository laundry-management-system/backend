# Biến môi trường cho máy local Mẫu: copy thành .env rồi sửa giá trị
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=laundry

JWT_SECRET=<chuỗi Base64 ngẫu nhiên >= 32 byte, ví dụ: node -e "console.log(require('crypto').randomBytes(64).toString('base64'))">
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAME_SITE=Lax
REFRESH_COOKIE_MAX_AGE=7

CORS_ORIGINS=http://localhost:5173
SETUP_PASSWORD_URL=http://localhost:5173/setup-password

# Điền khóa thật nếu cần gửi mail đặt mật khẩu; để giá trị giả thì app vẫn chạy, chỉ không gửi được mail
MAILJET_API_KEY=dev-placeholder
MAILJET_SECRET_KEY=dev-placeholder
MAILJET_SENDER_EMAIL=no-reply@example.com
